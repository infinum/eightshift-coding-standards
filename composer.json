{
  "name": "infinum/eightshift-coding-standards",
  "type": "phpcodesniffer-standard",
  "description": "Eightshift WordPress Coding Standards",
  "keywords": [
    "phpcs",
    "standards",
    "WordPress",
    "Eightshift"
  ],
  "homepage": "https://github.com/infinum/eightshift-coding-standards",
  "license": "MIT",
  "authors": [
    {
      "name": "Denis Žoljom",
      "homepage": "https://github.com/dingo-d",
      "role": "Lead developer"
    },
    {
      "name": "Contributors",
      "homepage": "https://github.com/infinum/eightshift-coding-standards/graphs/contributors"
    }
  ],
  "require": {
    "php": ">=8.4",
    "phpcompatibility/phpcompatibility-wp": "^2.1.8",
    "wp-coding-standards/wpcs": "3.3.0",
    "slevomat/coding-standard": "^8.22.1"
  },
  "require-dev": {
    "phpunit/phpunit": "^9.6.34",
    "phpcsstandards/phpcsdevtools": "^1.2.3",
    "php-parallel-lint/php-parallel-lint": "^1.4.0",
    "php-parallel-lint/php-console-highlighter": "^1.0.0",
    "roave/security-advisories": "dev-master",
    "szepeviktor/phpstan-wordpress": "2.0.3",
    "rector/rector": "^2.4"
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "scripts": {
    "test:types": "@php ./vendor/bin/phpstan analyze",
    "test:standards": "@php ./vendor/squizlabs/php_codesniffer/bin/phpcs --runtime-set testVersion 8.4-",
    "test:unit": "@php ./vendor/phpunit/phpunit/phpunit --filter Eightshift ./vendor/squizlabs/php_codesniffer/tests/AllTests.php",
    "test:unit-checkcs": "@php ./vendor/squizlabs/php_codesniffer/bin/phpcs -ps ./Tests/RulesetCheck/ --standard=Eightshift",
    "test:check-complete": "@php ./vendor/phpcsstandards/phpcsdevtools/bin/phpcs-check-feature-completeness -q ./Eightshift",
    "test:check-complete-strict": "@php ./vendor/phpcsstandards/phpcsdevtools/bin/phpcs-check-feature-completeness ./Eightshift",
    "test:rector": "@php ./vendor/bin/rector process --dry-run",
    "fix:standards": "@php ./vendor/squizlabs/php_codesniffer/bin/phpcbf --runtime-set testVersion 8.4-",
    "fix:rector": "@php ./vendor/bin/rector process",
    "test": [
      "@test:rector",
      "@test:standards",
      "@test:types",
      "@test:unit",
      "@test:unit-checkcs",
      "@test:check-complete",
      "@test:check-complete-strict"
    ]
  },
  "support": {
    "issues": "https://github.com/infinum/eightshift-coding-standards/issues",
    "source": "https://github.com/infinum/eightshift-coding-standards"
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  }
}
